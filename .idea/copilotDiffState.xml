index:0;pointer-events:none;&#10;      background-image:var(--ray-images),var(--fish-image);&#10;      background-repeat:var(--ray-repeat),repeat;&#10;      background-position:var(--ray-position),0 0;&#10;      background-size:var(--ray-size),520px 350px;&#10;    }&#10;    /* Rising bubble field near the left edge of the board. */&#10;    .shell::before{&#10;      content:&quot;&quot;;position:fixed;z-index:0;pointer-events:none;&#10;      left:1%;bottom:0;width:80px;height:100%;&#10;      background-image:&#10;        radial-gradient(circle,rgba(255,255,255,.55) 0 3px,transparent 4px),&#10;        radial-gradient(circle,rgba(255,255,255,.4) 0 2px,transparent 3px),&#10;        radial-gradient(circle,rgba(255,255,255,.4) 0 2.5px,transparent 3.5px);&#10;      background-repeat:repeat-y,repeat-y,repeat-y;&#10;      background-size:60px 160px,60px 160px,60px 160px;&#10;      background-position:10px 20px,40px 90px,25px 140px;&#10;      animation:bubbles 9s linear infinite;&#10;    }&#10;    /* Positioned so this content paints above the z-index:0 ocean/bubble pseudo-elements instead of behind them. */&#10;    .masthead{position:relative;z-index:1;display:flex;align-items:end;justify-content:space-between;margin-bottom:20px;margin-left:10px}&#10;    .eyebrow{font:700 11px/1.2 Arial, sans-serif;letter-spacing:.16em;color:var(--green);text-transform:uppercase}&#10;    h1{margin:3px 0 0;font-family:&quot;Lyon&quot;, Georgia, serif; font-size:40px; color:var(--ink); font-weight:700;}&#10;    .layout{position:relative;z-index:1;display:grid;grid-template-columns:1fr 360px;gap:28px}&#10;        .board-wrap{background:transparent;padding:6px;border-radius:12px}&#10;        .board-frame{background:#07121a;border-radius:12px;padding:14px;border:8px solid #fff;box-shadow:0 12px 30px rgba(0,0,0,.25)}&#10;        #game{display:block;width:100%;height:auto;border-radius:8px;background:#07121a;}&#10;    .underboard{display:flex;justify-content:space-between;align-items:center;padding:12px}&#10;    .tip{color:var(--muted);font:12px/1.4 Arial, sans-serif}&#10;    .restart{background:var(--green-dark);color:#fff;padding:10px 14px;border-radius:6px;border:0}&#10;    .side{display:grid;gap:14px}&#10;    .panel { background: #fffdf8; border-radius: 12px; padding: 16px; color: #111; box-shadow: 0 6px 18px rgba(8,21,26,.06); border: 1px solid rgba(8,21,26,.04); border-top: 3px solid var(--green); }&#10;        .panel h2 { color: var(--ink); margin-top: 0; margin-bottom: 2px; }&#10;        .controls { color: #0b1a1f; font: 11px/1.65 Arial, sans-serif; }&#10;        .controls strong { color: #0b1a1f; }&#10;        .player-row { color: #0b1a1f; }&#10;        .player-percent { color: #0b1a1f; }&#10;        .row-meta { color: rgba(11,26,31,.6); }&#10;    .player-list{display:grid;gap:10px}&#10;    .player-row{display:grid;grid-template-columns:28px 1fr 56px;gap:9px;align-items:center;font:700 12px Arial, sans-serif}&#10;    .dot{width:24px;height:24px;border-radius:50%;border:3px solid rgba(0,0,0,.12)}&#10;    .row-meta{color:var(--muted);font:11px;font-weight:400;margin-top:3px}&#10;    .score-bar{height:12px;background:#eef6ee;border-radius:8px;margin-top:8px;overflow:hidden}&#10;    .score-fill{height:100%;width:0%;transition:width 220ms linear}&#10;    .player-percent{text-align:right;color:#0b1a1f;font-weight:700}&#10;    @keyframes fish-drift{from{background-position:0 0}to{background-position:-520px 0}}&#10;    @keyframes bubbles{from{background-position:10px 20px,40px 90px,25px 140px}to{background-position:10px -140px,40px -70px,25px -20px}}&#10;    @media (prefers-reduced-motion:reduce){body::after,.shell::before{animation:none}}&#10;  &lt;/style&gt;&#10;  &lt;style&gt;&#10;  #fullscreenExit{display:none;position:fixed;top:12px;right:12px;z-index:9999;background:#fff;color:#111;border-radius:6px;padding:8px 12px;border:0;box-shadow:0 6px 18px rgba(0,0,0,.35);}&#10;  #fullscreenBtn{background:var(--pink);color:#fff;border:0;padding:8px 12px;border-radius:4px;cursor:pointer}&#10;  /* Fullscreen now targets the whole shell (board + side panel with QR/leaderboard/stats)&#10;     instead of just the canvas, so joining, high scores and live stats stay visible. */&#10;  #arenaRoot:fullscreen, #arenaRoot:-webkit-full-screen{width:100vw;height:100vh;max-width:none;padding:24px;box-sizing:border-box;background:var(--sea-gradient);overflow:auto;display:flex;flex-direction:column;justify-content:center}&#10;  #arenaRoot:fullscreen .layout, #arenaRoot:-webkit-full-screen .layout{width:100%}&#10;  /* The board normally sizes itself from column width (height:auto), which can make it taller than the&#10;     screen once the side panels are added back in; sizing it from the available height instead means the&#10;     whole layout fits in one viewport and #arenaRoot never needs to scroll. */&#10;  #arenaRoot:fullscreen .board-frame, #arenaRoot:-webkit-full-screen .board-frame{height:calc(100vh - 220px);display:flex;align-items:center;justify-content:center}&#10;  #arenaRoot:fullscreen #game, #arenaRoot:-webkit-full-screen #game{width:auto;height:100%;max-width:100%}&#10;  &lt;/style&gt;&#10;  &lt;/head&gt;&#10;&lt;body&gt;&#10;  &lt;main class=&quot;shell&quot; id=&quot;arenaRoot&quot;&gt;&#10;    &lt;div class=&quot;layout&quot;&gt;&#10;      &lt;div class=&quot;board-col&quot;&gt;&#10;        &lt;header class=&quot;masthead&quot;&gt;&#10;          &lt;div&gt;&lt;div class=&quot;eyebrow&quot;&gt;KLP JavaZone 2026&lt;/div&gt;&lt;h1&gt;Fiskekampen&lt;/h1&gt;&lt;div class=&quot;eyebrow&quot; style=&quot;margin-top:6px&quot;&gt;Ta territorium&lt;/div&gt;&lt;/div&gt;&#10;        &lt;/header&gt;&#10;        &lt;section class=&quot;board-wrap&quot;&gt;&#10;          &lt;div class=&quot;board-frame&quot;&gt;&lt;canvas id=&quot;game&quot; width=&quot;1120&quot; height=&quot;672&quot; aria-label=&quot;Fiskekampen game board&quot;&gt;&lt;/canvas&gt;&lt;/div&gt;&#10;                  &lt;div class=&quot;underboard&quot;&gt;&#10;                    &lt;div style=&quot;display:inline-block;width:100%;text-align:right;vertical-align:top&quot;&gt;&#10;                      &lt;div style=&quot;display:flex;justify-content:flex-end;gap:10px;align-items:center&quot;&gt;&#10;                        &lt;button class=&quot;restart&quot; id=&quot;restart&quot;&gt;START RUNDE PÅ NYTT&lt;/button&gt;&#10;                        &lt;button id=&quot;fullscreenBtn&quot; class=&quot;restart&quot;&gt;FULLSKJERM&lt;/button&gt;&#10;                      &lt;/div&gt;&#10;                    &lt;/div&gt;&#10;                  &lt;/div&gt;&#10;        &lt;/section&gt;&#10;      &lt;/div&gt;&#10;      &lt;aside class=&quot;side&quot;&gt;&#10;        &lt;section class=&quot;panel&quot;&gt;&lt;h2&gt;Spillere&lt;/h2&gt;&lt;div class=&quot;player-list&quot; id=&quot;players&quot;&gt;&lt;/div&gt;&lt;/section&gt;&#10;        &lt;section class=&quot;panel&quot; id=&quot;queuePanel&quot; style=&quot;display:none&quot;&gt;&lt;h2&gt;Venteliste&lt;/h2&gt;&lt;div class=&quot;player-list&quot; id=&quot;queueList&quot;&gt;&lt;/div&gt;&lt;/section&gt;&#10;        &lt;section class=&quot;panel&quot;&gt;&lt;h2&gt;Toppliste&lt;/h2&gt;&lt;div class=&quot;player-list&quot; id=&quot;leaderboard&quot;&gt;&lt;/div&gt;&lt;/section&gt;&#10;        &lt;section class=&quot;panel&quot; id=&quot;joinPanel&quot; style=&quot;display:none;text-align:center&quot;&gt;&lt;h2&gt;Bli med&lt;/h2&gt;&lt;img id=&quot;qrImage&quot; src=&quot;&quot; alt=&quot;QR-kode for å bli med&quot; style=&quot;width:160px;height:160px;border-radius:8px;background:#fff;padding:8px&quot;&gt;&lt;p style=&quot;margin-top:8px;color:#000;font-weight:700&quot;&gt;BLI MED OG SAMLE FLEST MULIG POENG! &lt;/p&gt;&#10;        &lt;/section&gt;&#10;      &lt;/aside&gt;&#10;    &lt;/div&gt;&#10;    &lt;button id=&quot;fullscreenExit&quot;&gt;Exit full screen&lt;/button&gt;&#10;  &lt;/main&gt;&#10;    &lt;script src=&quot;/js/klp-arena-engine.js&quot;&gt;&lt;/script&gt;&#10;&lt;/body&gt;&#10